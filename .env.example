# Copy to .env (never commit .env) or set in your shell.
# Optional - without it JK Assistance answers from the rule engines + evidence (no LLM wording).
ANTHROPIC_API_KEY=
# Model and effort for answer composition
JK_MODEL=claude-opus-5-5
JK_EFFORT=medium
# Replay a scenario on a fixed date (YYYY-MM-DD); empty = real today
JK_TODAY=
# Days before a deadline that trigger ALERT
JK_ALERT_WINDOW_DAYS=14
# Set to 1 to force rule-engine-only answers even if a key is present
JK_DISABLE_LLM=
